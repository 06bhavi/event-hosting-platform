# Managed by Ansible - do not edit by hand

define command {
    command_name    check_web_alive
    command_line    $USER1$/check_tcp -H $HOSTADDRESS$ -p 80
}

define command {
    command_name    check_event_http
    command_line    $USER1$/check_http -I $HOSTADDRESS$ -p 80 -u / -w 2 -c 5
}

define command {
    command_name    check_event_ssh
    command_line    $USER1$/check_ssh $HOSTADDRESS$
}

define host {
    use                   generic-host
    host_name             web-server
    alias                 Event Registration Web Server
    address               {{ hostvars['web-server'].private_ip }}
    check_command         check_web_alive
    max_check_attempts    3
    check_interval        1
    retry_interval        1
}

define service {
    use                   generic-service
    host_name             web-server
    service_description   HTTP
    check_command         check_event_http
    max_check_attempts    3
    check_interval        1
    retry_interval        1
}

define service {
    use                   generic-service
    host_name             web-server
    service_description   SSH
    check_command         check_event_ssh
    max_check_attempts    3
    check_interval        1
    retry_interval        1
}
